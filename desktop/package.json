{
  "name": "plume",
  "productName": "Plume",
  "version": "1.2.0",
  "description": "Plume — traitement de texte de Pixel's ASBL, compatible .docx",
  "author": "Pixel's ASBL <info@asblpixels.be>",
  "homepage": "https://github.com/asblPixels/plume",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist:win": "node prepare.js && electron-builder --win nsis portable --x64",
    "dist:linux": "node prepare.js && electron-builder --linux AppImage rpm deb --x64"
  },
  "build": {
    "appId": "be.asblpixels.plume",
    "productName": "Plume",
    "copyright": "© 2026 Pixel's ASBL",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Document Word",
        "description": "Document Word",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "docm",
        "name": "Document Word avec macros",
        "description": "Document Word avec macros",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "dotx",
        "name": "Modèle Word",
        "description": "Modèle Word",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "doc",
        "name": "Document Word 97-2003",
        "description": "Document Word 97-2003",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "dot",
        "name": "Modèle Word 97-2003",
        "description": "Modèle Word 97-2003",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "odt",
        "name": "Document OpenDocument",
        "description": "Document OpenDocument",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "ott",
        "name": "Modèle OpenDocument",
        "description": "Modèle OpenDocument",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "fodt",
        "name": "Document OpenDocument XML",
        "description": "Document OpenDocument XML",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "rtf",
        "name": "Texte enrichi",
        "description": "Texte enrichi",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "md",
        "name": "Markdown",
        "description": "Markdown",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "wpd",
        "name": "WordPerfect",
        "description": "WordPerfect",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "wps",
        "name": "Microsoft Works",
        "description": "Microsoft Works",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "pages",
        "name": "Apple Pages",
        "description": "Apple Pages",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "sxw",
        "name": "OpenOffice 1.x",
        "description": "OpenOffice 1.x",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Plume",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Plume-Setup-${version}-x64.${ext}",
      "language": "1036"
    },
    "portable": {
      "artifactName": "Plume-Portable-${version}-x64.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage",
        "rpm",
        "deb"
      ],
      "mimeTypes": [
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/msword",
        "application/vnd.oasis.opendocument.text",
        "application/rtf",
        "text/markdown"
      ],
      "maintainer": "Pixel's ASBL <info@asblpixels.be>"
    },
    "publish": null,
    "deb": {
      "packageName": "plume"
    }
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/asblPixels/Plume.git"
  }
}